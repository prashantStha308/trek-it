    {
      "name": "AUTHORIZED ROUTES",
      "description": "Routes requiring authentication (Guide/Admin)",
      "item": [
        {
          "name": "Update Guide Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Prashant Shrestha",
                  "type": "text",
                  "disabled": true
                },
                {
                  "key": "age",
                  "value": "28",
                  "type": "text",
                  "disabled": true
                },
                {
                  "key": "gender",
                  "value": "male",
                  "type": "text",
                  "disabled": true
                },
                {
                  "key": "location",
                  "value": "Kathmandu, Nepal",
                  "type": "text",
                  "disabled": true
                },
                {
                  "key": "regions",
                  "value": "[\"Kathmandu\", \"Pokhara\"]",
                  "type": "text",
                  "disabled": true
                },
                {
                  "key": "specialities",
                  "value": "[\"mountain\", \"adventure\"]",
                  "type": "text",
                  "disabled": true
                },
                {
                  "key": "profilePicture",
                  "type": "file",
                  "src": [],
                  "disabled": true
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/guides/{{guide_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "guides",
                "{{guide_id}}"
              ]
            },
            "description": "Update guide profile information and/or profile picture"
          },
          "response": []
        }
      ]
    },
