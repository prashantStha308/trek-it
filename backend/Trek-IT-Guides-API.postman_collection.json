              }
            ],
            "url": {
              "raw": "{{base_url}}/api/guides/admin/unverified?limit=10&page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "guides",
                "admin",
                "unverified"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10",
                  "disabled": false
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": false
                }
              ]
            },
            "description": "Get guides pending verification (Admin only)"
          },
          "response": []
        },
        {
          "name": "Verify Guide",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "body": {},
            "url": {
              "raw": "{{base_url}}/api/guides/admin/{{guide_id}}/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "guides",
