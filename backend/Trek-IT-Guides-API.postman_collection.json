      "description": "Public endpoints - No authentication required",
      "item": [
        {
          "name": "Get All Guides",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/guides?limit=10&page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "guides"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10",
                  "disabled": false
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": false
                },
                {
                  "key": "region",
                  "value": "kathmandu",
                  "disabled": true
                },
                {
                  "key": "speciality",
                  "value": "trekking",
                  "disabled": true
                },
                {
                  "key": "verified",
                  "value": "true",
                  "disabled": true
                }
              ]
            },
            "description": "Get all guides with optional filters and pagination"
          },
          "response": []
        },
        {
